# Public — used by the browser client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret — server-only, used by app/api/reviews/route.js
# Get this from Supabase: Project Settings -> API -> service_role key
# NEVER expose this in client-side code or commit it to git
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
